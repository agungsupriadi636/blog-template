---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import BreadCrumb from "@components/BreadCrumb.astro";

import { MainLayout, FormattedDate } from "@utils/index";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return posts.map((post) => ({
		params: { title: post.data.title },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);

const pageUrl = Astro.url.href;
const pageTitle = post.data.title;
const encodedUrl = encodeURIComponent(pageUrl);
const encodedTitle = encodeURIComponent(pageTitle);

const shares = [
	{
		sosmed: "fb",
		link: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
	},
	{
		sosmed: "wa",
		link: `https://wa.me/?text=${encodedTitle}%20${encodedUrl}`,
	},
	{
		sosmed: "tw",
		link: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
	},
	{
		sosmed: "in",
		link: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
	},
];
---

<MainLayout title={post.data.title} description={post.data.description}>
	<article>
		<header class="mb-4 space-y-4">
			<BreadCrumb
				categories={post.data.categories}
				title={post.data.title}
			/>
			<h1 class="text-3xl font-bold">{post.data.title}</h1>
			<p>{post.data.description}</p>
			<div class="flex gap-4 flex-wrap text-[14px]">
				<span class="flex items-center gap-1"
					><Icon name="user" size={13} />{post.data.author}</span
				>
				<span class="flex items-center gap-1"
					><Icon name="categories" size={13} />{
						post.data.categories
					}</span
				>
				<span class="flex items-center gap-1"
					><Icon name="time" size={13} /><FormattedDate
						date={post.data.pubDate}
					/></span
				>
				<span class="flex items-center gap-1"
					><Icon name="eye" size={13} />{
						remarkPluginFrontmatter.minutesRead
					}</span
				>
			</div>
			<figure>
				<Image
					class="w-full aspect-[4/2] object-cover rounded-lg shadow-xl"
					src={post.data.heroImage}
					alt={post.data.title}
					loading="eager"
				/>
				<figcaption class="mx-auto mt-4 text-center text-sm">
					{post.data.title}
				</figcaption>
			</figure>
		</header>
		<div
			class="prose prose-p:text-neutral-700 dark:prose-p:text-neutral-300 prose-a:{utility}"
		>
			<Content />
		</div>
		<div class="flex gap-2 items-center mt-8">
			<p><b>Tags :</b></p>
			<div class="flex gap-2 flex-wrap items-center">
				{
					post.data.tags?.map((tag) => (
						<a
							class="px-3 py-1 bg-gray-100 rounded-sm text-sm hover:bg-blue-700 hover:text-white transitio-all"
							href={`/blog/tags/${tag}`}
						>
							# {tag}
						</a>
					))
				}
			</div>
		</div>
	</article>

	<div class="flex items-center gap-2 mt-8">
		<span class="text-sm"><b>Share :</b></span>
		<ul class="flex gap-2 items-center">
			{
				shares.map((share) => (
					<li class=" p-2 rounded-full bg-blue-700 text-white hover:bg-blue-800 transition-all">
						<a href={share.link} target="_blank">
							<Icon name={share.sosmed} />
						</a>
					</li>
				))
			}
		</ul>
	</div>
</MainLayout>
