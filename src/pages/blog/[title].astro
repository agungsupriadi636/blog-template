---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import BreadCrumb from "@components/BreadCrumb.astro";
import WidgetComponent from "@components/WidgetComponent.astro";
import { blogList } from "@utils/index";

import { MainLayout, FormattedDate } from "@utils/index";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return posts.map((post) => ({
		params: { title: post.data.title },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);

// navigasi single post
const currentIndex = blogList.findIndex(
	(blog) => blog.data.title === post.data.title,
);
const prevPost = blogList[currentIndex + 1];
const nextPost = blogList[currentIndex - 1];

// Filter related posts: kategori sama dan bukan post ini
const relatedPosts = blogList
	.filter(
		(blog) =>
			blog.data.title !== post.data.title &&
			blog.data.categories === post.data.categories,
	)
	.slice(0, 3); // Ambil maksimal 3 related

const pageUrl = Astro.url.href;
const pageTitle = post.data.title;
const encodedUrl = encodeURIComponent(pageUrl);
const encodedTitle = encodeURIComponent(pageTitle);

const shares = [
	{
		sosmed: "fb",
		link: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
	},
	{
		sosmed: "wa",
		link: `https://wa.me/?text=${encodedTitle}%20${encodedUrl}`,
	},
	{
		sosmed: "tw",
		link: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
	},
	{
		sosmed: "in",
		link: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
	},
];
---

<MainLayout title={post.data.title} description={post.data.description}>
	<article>
		<header class="mb-4 space-y-4">
			<BreadCrumb
				categories={post.data.categories}
				title={post.data.title}
			/>
			<h1
				class="text-3xl font-bold text-neutral-900 dark:text-neutral-100"
			>
				{post.data.title}
			</h1>
			<p>{post.data.description}</p>
			<div class="flex gap-4 flex-wrap text-[14px]">
				<span class="flex items-center gap-1"
					><Icon name="user" size={13} />{post.data.author}</span
				>
				<span class="flex items-center gap-1"
					><Icon name="categories" size={13} />{
						post.data.categories
					}</span
				>
				<span class="flex items-center gap-1"
					><Icon name="time" size={13} /><FormattedDate
						date={post.data.pubDate}
					/></span
				>
				<span class="flex items-center gap-1"
					><Icon name="eye" size={13} />{
						remarkPluginFrontmatter.minutesRead
					}</span
				>
			</div>
			<figure>
				<Image
					class="w-full aspect-[4/2] object-cover rounded-lg shadow-xl"
					src={post.data.heroImage}
					alt={post.data.title}
					loading="eager"
				/>
				<figcaption class="mx-auto mt-4 text-center text-sm">
					{post.data.title}
				</figcaption>
			</figure>
		</header>
		<div class="prose proses-neutral dark:prose-invert">
			<Content />
		</div>
		<div class="flex gap-2 items-center mt-8">
			<p><b>Tags :</b></p>
			<div class="flex gap-2 flex-wrap items-center">
				{
					post.data.tags?.map((tag) => (
						<a
							class="px-3 py-1 bg-neutral-400 text-neutral-900 hover:bg-neutral-500 rounded-sm text-sm dark:bg-neutral-800 dark:hover:bg-neutral-700 dark:text-neutral-50 transitio-all"
							href={`/tags/${tag}`}
						>
							# {tag}
						</a>
					))
				}
			</div>
		</div>
	</article>

	{/** share link */}
	<div class="flex items-center gap-2 mt-8">
		<span class="text-sm"><b>Share :</b></span>
		<ul class="flex gap-2 items-center">
			{
				shares.map((share) => (
					<li class=" p-2 rounded-full bg-blue-700 text-blue-50 hover:bg-blue-800 dark:bg-blue-400 dark:text-blue-900 dark:hover:bg-blue-500 transition-all">
						<a href={share.link} target="_blank">
							<Icon name={share.sosmed} />
							<span class="sr-only">{share.sosmed}</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>

	{/** pagination post */}
	<nav class="flex gap-8 items-center mt-8">
		<div class="basis-1/2">
			{
				nextPost ? (
					<a
						class="line-clamp-2 hover:text-blue-700 transition-all"
						href={`/blog/${nextPost.data.title}`}
					>
						{nextPost.data.title}
					</a>
				) : null
			}
		</div>
		<div class="basis-1/2">
			{
				prevPost ? (
					<a
						class="line-clamp-2 hover:text-blue-700 transition-all"
						href={`/blog/${prevPost.data.title}`}
					>
						{prevPost.data.title}
					</a>
				) : null
			}
		</div>
	</nav>

	{/** relate post by categories */}
	<WidgetComponent title="Related Post">
		{
			relatedPosts.length > 0 ? (
				<ul class="grid grid-cols-2 md:grid-cols-3 gap-8">
					{relatedPosts.map((post) => (
						<li>
							<article class="block">
								<a
									href={post.data.title}
									class="w-full inline-block aspect-video rounded-lg overflow-hidden"
								>
									<Image
										src={post.data.heroImage}
										alt={post.data.title}
										class="size-full block object-cover hover:scale-125 transition-all duration-300"
									/>
								</a>
								<div class="mt-2">
									<h3 class="line-clamp-2">
										<a
											href={`/blog/${post.data.title}`}
											class="bg-[length:0_2px] bg-gradient-to-r from-blue-700 to-blue-700 dark:bg-[linear-gradient(white,white)] bg-no-repeat bg-bottom-left transition-all duration-300 hover:bg-[length:100%_2px]"
										>
											{post.data.title}
										</a>
									</h3>
								</div>
							</article>
						</li>
					))}
				</ul>
			) : (
				<div class="rounded-lg bg-neutral-200 dark:bg-neutral-900 shadow p-4">
					<p>Tidak ada post yang terkait dengan kategori ini.</p>
				</div>
			)
		}
	</WidgetComponent>
</MainLayout>
