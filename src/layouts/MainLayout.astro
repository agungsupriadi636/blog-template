---
import { getCollection } from "astro:content";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import BaseHead from "@components/BaseHead.astro";
import WidgetComponent from "@components/WidgetComponent.astro";
import SeacrhForm from "@components/SeacrhForm.astro";
import "../styles/global.css";
const { title, description } = Astro.props;
const posts = await getCollection("blog");
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<title>{title}</title>
		<BaseHead title={title} description={description} />
	</head>
	<body
		class="relative min-dvh bg-neutral-100 text-neutral-600 dark:bg-neutral-900 dark:text-neutral-400 font-family"
	>
		<Header />
		<SeacrhForm />
		<main class="h-auto max-w-5xl mx-auto px-6 lg:px-0 pt-6 pb-12">
			<slot name="before-main" />

			<div class="flex flex-col gap-8 md:flex-row">
				<div class="md:basis-2/3 flex-1 space-y-8 overflow-x-hidden">
					<slot />
				</div>
				<aside class="md:basis-1/3 space-y-8">
					<!-- postingan terbaru -->
					<WidgetComponent title="Post Terbaru">
						{
							posts.map((post) => (
								<h3 class="text-sm font-semibold hover:underline transition-all text-neutral-900 dark:text-neutral-100 hover:text-blue-700 hover:dark:text-blue-400">
									<a href={`/blog/${post.data.title}`}>
										{post.data.title}
									</a>
								</h3>
							))
						}
					</WidgetComponent>

					<!-- all categorie -->
					<WidgetComponent title="Kategori">
						<div class="flex flex-wrap gap-2">
							{
								posts.map((post) => (
									<a
										href={`/categories/${post.data.categories}`}
										class="text-sm py-1 px-3 rounded-sm bg-blue-700 hover:bg-blue-800 dark:bg-blue-400 dark:text-neutral-900 dark:hover:bg-blue-500 text-blue-50 dark:text-blue-900 font-semibold transition-all"
									>
										{post.data.categories}
									</a>
								))
							}
						</div>
					</WidgetComponent>

					<!-- wiget iklan -->
					<WidgetComponent title="Iklan" />
				</aside>
			</div>

			<slot name="after-main" />
		</main>
		<Footer />
		<script is:inline>
			// search
			const search = document.getElementById("button-search");
			const searchContainer = document.getElementById("search");
			const closeSearch = document.getElementById("close");

			search.addEventListener("click", () => {
				searchContainer.classList.remove("hidden");
			});

			closeSearch.addEventListener("click", () => {
				searchContainer.classList.add("hidden");
			});
		</script>
	</body>
</html>
