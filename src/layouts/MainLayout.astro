---
import { getCollection } from "astro:content";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import BaseHead from "@components/BaseHead.astro";
import WidgetComponent from "@components/WidgetComponent.astro";
import "../styles/global.css";
const { title, description } = Astro.props;

const posts = await getCollection("blog");
---

<!doctype html>
<html lang="en" class="">
	<head>
		<meta charset="UTF-8" />
		<title>{title}</title>
		<BaseHead title={title} description={description} />
	</head>
	<body
		class="relative min-dvh bg-white text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300"
	>
		<Header />
		<main class="h-auto max-w-5xl mx-auto px-6 lg:px-0 pt-6 pb-12">
			{
				Astro.url.pathname === "/" ? (
					<div class="overflow-hidden w-full p-2 bg-neutral-100 dark:bg-neutral-900 rounded-md mb-6">
						<div class="marquee-container">
							<ul class="marquee-content">
								{posts.slice(0, 4).map((post) => (
									<li class="inline-block mx-8 text-sm font-semibold">
										<span>&diams;</span>
										<a
											href={`/blog/${post.data.title}`}
											class="hover:underline"
										>
											{post.data.title}
										</a>
									</li>
								))}
							</ul>
						</div>
					</div>
				) : (
					""
				)
			}
			<div class="flex flex-col gap-8 md:flex-row">
				<div class="md:basis-2/3 flex-1 space-y-8 overflow-x-hidden">
					<slot />
				</div>
				<aside class="md:basis-1/3 space-y-8">
					<!-- postingan terbaru -->
					<WidgetComponent title="Post Terbaru">
						{
							posts.map((post) => (
								<h3 class="text-sm font-semibold">
									<a href={post.id}>{post.data.title}</a>
								</h3>
							))
						}
					</WidgetComponent>

					<!-- all categorie -->
					<WidgetComponent title="Kategori">
						<div class="flex flex-wrap gap-2">
							{
								posts.map((post) => (
									<a
										href={`/categories/${post.data.categories}`}
										class="text-sm py-1 px-3 rounded-sm bg-blue-700 text-white font-semibold"
									>
										{post.data.categories}
									</a>
								))
							}
						</div>
					</WidgetComponent>

					<!-- wiget iklan -->
					<WidgetComponent title="Iklan" />
				</aside>
			</div>

			<slot name="after-main" />
		</main>
		<Footer />
	</body>
</html>
