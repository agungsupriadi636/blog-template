---
import HeaderLink from "./HeaderLink.astro";
import SeacrhForm from "@components/SeacrhForm.astro";
import { SITE_TITLE, navLinks } from "../consts";
import DarkMode from "./DarkMode.astro";

import { Icon } from "astro-icon/components";
---

<header
    class="py-8 sticky top-0 z-50 bg-neutral-100 dark:bg-neutral-900 shadow-lg font-heading"
>
    <div
        class="mx-auto px-6 lg:px-0 max-w-5xl h-5 flex justify-between items-center"
    >
        <button id="button-menu" class="block lg:hidden">
            <Icon name="menu" size={20} />
        </button>

        <div class="flex gap-8 items-center">
            <a
                href="/"
                class="text-2xl font-semibold text-blue-700 dark:text-blue-400"
                >{SITE_TITLE}</a
            >

            <nav
                class="hidden lg:flex items-center gap-8 texxt-md font-semi-bold"
            >
                {
                    navLinks.map((nav) => (
                        <HeaderLink
                            class="hover:text-blue-800 dark:hover:text-blue-400"
                            href={nav.url}
                        >
                            {nav.label}
                        </HeaderLink>
                    ))
                }
            </nav>
        </div>

        <div class="flex items-center gap-2">
            <DarkMode />
            <div>
                <button
                    id="button-search"
                    class="p-2 rounded-full bg-blue-700 hover:bg-blue-800 transition-all dark:bg-blue-400 dark:hover:bg-blue-500 text-blue-50 dark:text-blue-900 cursor-pointer"
                >
                    <Icon name="search" size={18} />
                </button>
            </div>
        </div>
    </div>
</header>

<!-- mobile menu -->
<div
    id="mobile-menu"
    class="translate-x-full lg:hidden duration-300 transition-all fixed size-full top-0 bg-neutral-100 text-neutral-900 dark:bg-neutral-900 dark:text-neutral-50 insert-0 z-[99] font-heading"
>
    <div class="max-w-5xl mx-auto p-6 h-full">
        <div class="flex justify-end">
            <button
                id="button-close"
                class="inline-block ms-auto p-1 rounded-sm"
            >
                <Icon name="close" size={20} />
            </button>
        </div>

        <div class="mt-8">
            <nav class="flex flex-col gap-6">
                {
                    navLinks.map((n) => (
                        <HeaderLink class="hover:text-blue-700" href={n.url}>
                            {n.label}
                        </HeaderLink>
                    ))
                }
            </nav>
        </div>
    </div>
</div>

<script is:inline>
    const menu = document.getElementById("mobile-menu");
    const open = document.getElementById("button-menu");

    open.addEventListener("click", () => {
        menu.classList.remove("translate-x-full");
    });

    const close = document.getElementById("button-close");

    close.addEventListener("click", () => {
        menu.classList.add("translate-x-full");
    });
</script>
