---
import HeaderLink from "./HeaderLink.astro";
import SeacrhForm from "@components/SeacrhForm.astro";
import { SITE_TITLE, navLinks } from "../consts";
import DarkMode from "./DarkMode.astro";

import { Icon } from "astro-icon/components";
---

<header class="py-4 bg-red-500">
  <div
    class="mx-auto px-6 lg:px-0 max-w-5xl bg-green-500 h-5 flex justify-between items-center"
  >
    <div class="flex gap-2 items-center">
      <button class="hidden">
        <Icon name="menu" />
      </button>
      <div class="flex gap-4 items-center">
        <a href="/" class="text-2xl font-bold">AsBlog</a>

        <nav class="text-md font-semi-bold">
          {
            navLinks.map((nav) => (
              <HeaderLink href={nav.url}>{nav.label}</HeaderLink>
            ))
          }
        </nav>
      </div>
    </div>

    <div class="space-x-4">
      <DarkMode />
      <button class="p-2 bg-red-500 rounded-full hover:bg-red-600">
        <Icon name="search" size={18} />
      </button>
    </div>
  </div>
</header>
