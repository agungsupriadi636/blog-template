---
const today = new Date();
import { SITE_TITLE, socialMedia, footerLinks } from "../consts";
import { Icon } from "astro-icon/components";
---

<footer
	class="bg-neutral-300 dark:bg-neutral-800 dark:text-white h-fit mt-auto"
>
	<div class="max-w-5xl px-6 lg:px-0 mx-auto py-8">
		<div class="fixed bottom-6 right-6 z-[96]">
			<button
				id="scrollTopBtn"
				class="hidden p-2 rounded-full bg-blue-700 hover:bg-blue-800 text-blue-50 dark:bg-blue-400 dark:text-blue-900 hover:bg-blue-800 dark:hover:bg-blue-500 transition-all"
				><Icon class="-rotate-90" name="arrow" size={18} /></button
			>
		</div>
		<div
			class="flex flex-col gap-4 md:flex-row md:justify-between justify-center items-center"
		>
			{/*link bottom*/}
			<div class="flex gap-2 items-center">
				{
					socialMedia.map((sos) => (
						<a
							class="p-2 rounded-full transition-all bg-neutral-400 hover:bg-neutral-500 text-neutral-900 dark:bg-neutral-900 dark:text-neutral-50 dark:hover:bg-neutral-950"
							href={sos.url}
						>
							<Icon name={sos.label} />
							<span class="sr-only">{sos.label}</span>
						</a>
					))
				}
			</div>

			<nav class="flex items-center gap-4">
				{
					footerLinks.map((footer) => (
						<a
							class="text-neutral-900 dark:text-neutral-50 hover:text-blue-800 transition-all dark:hover:text-blue-400"
							href={footer.url}
						>
							{footer.label}
						</a>
					))
				}
			</nav>
		</div>
	</div>
	<div class="max-w-5xl mx-auto px-6 lg:px-0 py-8">
		<p class="text-center">
			&copy; {today.getFullYear()}
			<a href="/" class="text-blue-700 dark:text-blue-400">{SITE_TITLE}</a
			> All rights reserved.
		</p>
	</div>
</footer>

<script is:inline>
	document.addEventListener("DOMContentLoaded", () => {
		const scrollBtn = document.getElementById("scrollTopBtn");

		window.addEventListener("scroll", () => {
			if (window.scrollY > 50) {
				scrollBtn.classList.remove("hidden");
			} else {
				scrollBtn.classList.add("hidden");
			}
		});

		scrollBtn.addEventListener("click", () => {
			window.scrollTo({ top: 0, behavior: "smooth" });
		});
	});
</script>
