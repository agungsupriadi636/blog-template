---
const { title } = Astro.props;
---

<div class="space-y-2">
    <div>
        <h2 class="font-bold">{title}</h2>
        <hr class="w-12 border-1 border-blue-700" />
    </div>
    <div class="space-y-4">
        <slot>
            <p>
                This is my fallback content, if there is no child passed into
                slot {title}
            </p>
        </slot>
    </div>
</div>
