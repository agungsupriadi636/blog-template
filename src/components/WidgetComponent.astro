---
const { title } = Astro.props;
---

<div class="space-y-4">
    <div class="space-y-2">
        <h2 class="font-bold text-neutral-900 dark:text-neutral-100">
            {title}
        </h2>
        <hr class="w-12 border-1 border-emerald-500 dark:border-emerald-400" />
    </div>
    <div class="space-y-4">
        <slot>
            <p>
                This is my fallback content, if there is no child passed into
                slot {title}
            </p>
        </slot>
    </div>
</div>
