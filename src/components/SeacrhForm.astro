---

---

<div class="">
    <form action="">
        <div class="search-container">
            <input
                id="search-input"
                type="text"
                placeholder="Cari artikel..."
                value=""
                class="search-input"
            />
        </div>
    </form>

    <div id="results" class="space-y-2">
        <!-- Hasil pencarian akan muncul di sini -->
    </div>
</div>

<script is:inline>
    async function fetchAndFilterPosts(query) {
        try {
            const res = await fetch("/api/posts.json");
            const posts = await res.json();

            const terms = query.toLowerCase().split(/\s+/).filter(Boolean);

            const filtered = posts.filter((post) => {
                const data = post.data;
                if (!data) return false;

                const fieldValues = [
                    data.title || "",
                    data.categories || "",
                    ...(Array.isArray(data.tags) ? data.tags : []),
                ].map((str) => str.toLowerCase());

                // Semua kata kunci harus cocok di salah satu field
                return terms.every((term) =>
                    fieldValues.some((field) => field.includes(term)),
                );
            });

            displayResults(filtered, query);
        } catch (err) {
            console.error("Gagal fetch data:", err);
        }
    }

    function displayResults(results, query = "") {
        const container = document.getElementById("results");
        container.innerHTML = "";

        if (query.trim() === "") {
            // input kosong → tidak tampilkan apapun
            return;
        }

        if (results.length === 0) {
            container.innerHTML =
                '<p class="text-gray-500">Tidak ada hasil.</p>';
            return;
        }

        results.forEach((post) => {
            const item = document.createElement("div");
            item.className = "p-3 bg-white rounded shadow mb-2";

            const title = post.data?.title || "Tanpa Judul";
            const categories = post.data?.categories || "-";
            const tags = Array.isArray(post.data?.tags)
                ? post.data.tags.join(", ")
                : "-";

            item.innerHTML = `
      <h2 class="text-lg font-semibold"><a href="/blog/${title}">${title}</a></h2>
      <p class="text-sm text-gray-600">Kategori: ${categories}</p>
      <p class="text-sm text-gray-600">Tags: ${tags}</p>
    `;

            container.appendChild(item);
        });
    }

    function updateURLParam(param, value) {
        const url = new URL(window.location.href);
        if (value) {
            url.searchParams.set(param, value);
        } else {
            url.searchParams.delete(param);
        }
        window.history.replaceState({}, "", url);
    }

    document.addEventListener("DOMContentLoaded", () => {
        const input = document.getElementById("search-input");
        const params = new URLSearchParams(window.location.search);
        const existingSearch = params.get("search");

        // Jika ada parameter pencarian di URL, muat hasilnya
        if (existingSearch && existingSearch.trim().length >= 1) {
            input.value = existingSearch;
            fetchAndFilterPosts(existingSearch);
        }

        input.addEventListener("input", (e) => {
            const value = e.target.value.trim();

            updateURLParam("search", value);

            if (value.length >= 1) {
                fetchAndFilterPosts(value); // Cari data jika input ada
            } else {
                displayResults([], ""); // Kosongkan hasil jika input kosong
            }
        });
    });
</script>

<style>
    .search-container {
        position: relative;
        max-width: 600px;
        margin: 2rem auto;
    }

    .search-input {
        width: 100%;
        padding: 12px;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 16px;
    }

    .results {
        position: absolute;
        width: 100%;
        background: white;
        border: 1px solid #eee;
        border-radius: 8px;
        margin-top: 8px;
        max-height: 400px;
        overflow-y: auto;
        z-index: 10;
    }

    .results li {
        padding: 12px;
        border-bottom: 1px solid #f5f5f5;
    }

    .results li:hover {
        background-color: #f9f9f9;
    }

    .loading {
        padding: 8px;
        color: #666;
        text-align: center;
    }

    .no-results {
        padding: 8px;
        color: #888;
        margin-top: 8px;
    }
</style>
