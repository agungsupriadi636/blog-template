---
import { Image } from "astro:assets";
import { FormattedDate } from "@utils/index";
import { Icon } from "astro-icon/components";

const { post, index } = Astro.props;
---

<article class="flex flex-col sm:flex-row gap-4">
    <a
        href={`/blog/${post.data.title}`}
        class="basis-2/5 aspect-[4/3] rounded-lg overflow-hidden"
    >
        <Image
            loading={index < 3 ? "eager" : "lazy"}
            class="size-full object-cover block hover:scale-125 transition-all duration-300"
            src={post.data.heroImage}
            alt={post.data.title}
        />
    </a>
    <div class="basis-3/5 space-y-2">
        <h2 class="text-lg text-neutral-900 dark:text-neutral-100 font-bold">
            <a
                class="bg-[length:0_2px] bg-gradient-to-r from-blue-700 to-blue-700 dark:bg-[linear-gradient(white,white)] bg-no-repeat bg-bottom-left transition-all duration-300 hover:bg-[length:100%_2px]"
                href={`/blog/${post.data.title}`}>{post.data.title}</a
            >
        </h2>
        <div class="flex gap-4 flex-wrap text-[14px]">
            <span class="flex items-center gap-1"
                ><Icon name="user" size={13} />{post.data.author}</span
            >
            <a
                href={`/categories/${post.data.categories}`}
                class="flex items-center gap-1"
                ><Icon name="categories" size={13} />{post.data.categories}</a
            >
            <span class="flex items-center gap-1"
                ><Icon name="time" size={13} /><FormattedDate
                    date={post.data.pubDate}
                /></span
            >
        </div>
        <p class="text-sm">{post.data.description}</p>
    </div>
</article>
